# Copie este archivo como .env y cambie los valores. Nunca suba .env a Git.

# --- API ---
ECNT_DATABASE_URL=sqlite:///./data/storage/ecnt.db
# Para PostgreSQL: postgresql+psycopg://usuario:clave@localhost:5432/ecnt
ECNT_STORAGE_DIR=./data/storage
ECNT_JWT_SECRET=cambie-esto-por-un-valor-aleatorio-largo
ECNT_JWT_EXPIRE_MINUTES=120
ECNT_CORS_ORIGINS=http://localhost:8501,http://localhost:8502

# Usuarios iniciales (solo desarrollo; cámbielos)
ECNT_BOOTSTRAP_ADMIN_EMAIL=admin@ecnt.local
ECNT_BOOTSTRAP_ADMIN_PASSWORD=cambie-esta-clave
ECNT_BOOTSTRAP_EPS_EMAIL=eps@ecnt.local
ECNT_BOOTSTRAP_EPS_PASSWORD=cambie-esta-clave
ECNT_BOOTSTRAP_INVESTIGADOR_EMAIL=investigador@ecnt.local
ECNT_BOOTSTRAP_INVESTIGADOR_PASSWORD=cambie-esta-clave
# Supresión de conteos pequeños para el rol EPS
ECNT_MIN_CELL_SIZE=10

# --- Docker Compose: puertos del host (opcional) ---
# ECNT_API_PORT=8000
# ECNT_ADMIN_PORT=8501
# ECNT_EPS_PORT=8502

# --- Apps cliente ---
ECNT_API_URL=http://127.0.0.1:8000
